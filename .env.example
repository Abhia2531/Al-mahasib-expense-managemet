# Copy to .env and fill in. .env is gitignored - never commit it.
#
# Both values are PUBLIC by design: they are inlined into the browser bundle
# (that is what NEXT_PUBLIC_ means). There is deliberately NO secret /
# service-role key -- access is controlled by Supabase Auth + Row Level
# Security (see supabase/auth-policies.sql).
#
# From: Supabase Dashboard -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
