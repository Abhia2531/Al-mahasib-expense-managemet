# Supabase — copy to .env and fill in real values.
# Dashboard: Project Settings -> API Keys
#
# Read on the server only. Not prefixed with NEXT_PUBLIC_, so Next.js never
# inlines them into the browser bundle.

SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_URL is also accepted for the URL (it is not secret).

# The secret ("service_role") key. It bypasses Row Level Security, so it must
# never be imported into a Client Component and must never be renamed with a
# NEXT_PUBLIC_ prefix. src/lib/supabase.ts imports `server-only`, which turns
# any client-side import into a build error.
SUPABASE_SECRET_KEY=sb_secret_...

# Not used by this app. All database access happens server-side, so the
# publishable key is never needed — keep it only if you add browser-side
# Supabase calls later (which would also require RLS policies).
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
